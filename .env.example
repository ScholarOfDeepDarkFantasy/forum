# JavaForum 环境变量示例
#
# 两种用途：
#   1. 本地开发：复制为仓库根目录 .env，自行加载后 `mvn spring-boot:run`
#   2. raspi 部署：复制为 /pd/Program/forum/deploy/.env（podman-compose 自动读取）
#      —— 推荐直接按 docs/deployment/README.md 的引导生成，别手工抄
#
# 注意：application.yml 对 DB_PASSWORD 与 JWT_SECRET 没有设默认值，
# 缺失时应用启动即报 Could not resolve placeholder 并退出（刻意设计，避免弱密钥上线）。
# .env 已被 .gitignore 忽略；部署机上的 .env 权限应为 600。

# ==================== 本地开发（mvn / IDE，profile=dev） ====================
DB_URL=jdbc:postgresql://localhost:5432/javaforum
DB_USERNAME=forum
# 值里含 # $ 空格等特殊字符时，用单引号包裹，否则可能被当成注释或变量展开
# 例如：DB_PASSWORD='4*2j+#bVkNDP7:3EWcF9'
DB_PASSWORD='在这里填数据库密码'
SPRING_PROFILES_ACTIVE=dev

# 开发环境可选：
# SERVER_PORT=8080
# JWT_EXPIRATION_MS=86400000
# DB_POOL_MAX=10
# LOG_FILE=logs/javaforum.log

# ==================== raspi 部署（deploy/.env，profile 固定 prod） ====================
# 数据库复用主机上已有的 rootless postgresql 容器（库 javaforum，数据保留）。
# 容器内通过 host.containers.internal 访问宿主机（podman 自动注入）；
# 若解析失败（老版本 podman / 特殊网络），改成宿主机局域网 IP，如 192.168.3.4。
# DB_URL=jdbc:postgresql://host.containers.internal:5432/javaforum
# DB_USERNAME=forum
# DB_PASSWORD='...'
# JWT_SECRET='...'                    # openssl rand -hex 32，至少 32 字节
# HOST_PORT=8086                      # 后端只绑 127.0.0.1，由 nginx 反代
# TZ=Asia/Shanghai
# IMAGE_TAG=latest                    # 流水线每次部署自动改写为 BUILD_NUMBER
# JAVA_OPTS='-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError'
